# Non-secret configuration template (never commit real credentials)
APP_ENV=development
# Use project URL and publishable/anon key only in client-safe code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
# Service-role key is intentionally excluded from the app/client template.
