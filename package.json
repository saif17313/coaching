{
  "name": "coaching-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-first coaching management system.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify:structure": "node scripts/check-foundation.mjs",
    "verify": "npm run verify:structure && npm run lint && npm run typecheck && npm test && npm run audit:prod && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-three/drei": "^10.7.9",
