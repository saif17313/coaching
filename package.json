{
  "name": "coaching-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-first coaching management system.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "verify:structure": "node scripts/check-foundation.mjs",
    "verify": "npm run verify:structure && npm run lint && npm run typecheck && npm test && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "6.0.3"
  }
}
